# Satark uses any OpenAI-compatible chat endpoint. Default: Gemini (free key from aistudio.google.com).
# Leave LLM_API_KEY empty to run rules-only.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# true lets the model read screenshots directly (needed in deployment, where there is no Tesseract)
LLM_VISION=true

# Optional: tried once (same endpoint and key) if LLM_MODEL fails. Empty = rules-only after a failure.
# gemini-2.5-flash is a possible choice, but in testing it occasionally returned corrupt JSON and
# took up to 11s, so it is not enabled by default.
LLM_FALLBACK_MODEL=

LLM_TIMEOUT=40
# Cap on all LLM work for one request (one retry on 500/503, fallback model, everything), in seconds.
# A 429 is never retried: it goes straight to the fallback model, then to rules-only.
LLM_TOTAL_TIMEOUT=12
# Reply budget. Thinking models spend part of it on hidden reasoning, so don't set it too low.
LLM_MAX_TOKENS=2048
CORS_ORIGINS=*

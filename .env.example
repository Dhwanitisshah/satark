# Any OpenAI-compatible chat endpoint works. Leave LLM_API_KEY empty to run rules-only.

# Option A: Featherless (ForgeHacks perk: $25 credits, redeem in the Discord)
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_VISION=false

# Option B: Gemini (free tier, reads screenshots directly)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_VISION=true

LLM_TIMEOUT=40
CORS_ORIGINS=*

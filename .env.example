# Satark uses any OpenAI-compatible chat endpoint. Default: Gemini (free key from aistudio.google.com).
# Leave LLM_API_KEY empty to run rules-only.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# true lets the model read screenshots directly (needed in deployment, where there is no Tesseract)
LLM_VISION=true

# Optional fallback, tried once if the primary fails (429, 5xx, timeout or an unreadable reply).
# It can be a DIFFERENT provider: set its URL and its own key. It is text-only, so it is skipped for
# screenshot-only requests. Leave LLM_FALLBACK_MODEL empty to go straight to rules-only instead.
# Groq example (free key from console.groq.com; list the models your key can use with GET /models):
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
# If LLM_FALLBACK_BASE_URL is left empty the fallback uses the primary's URL and key (a second model on the
# same provider). The primary's key is never sent to a different provider.

LLM_TIMEOUT=40
# Cap on all LLM work for one request (one retry on 500/503, fallback model, everything), in seconds.
# A 429 is never retried: it goes straight to the fallback, then to rules-only.
LLM_TOTAL_TIMEOUT=12
# When a fallback is set, the primary may use at most this many seconds, so the fallback always gets the rest
# of LLM_TOTAL_TIMEOUT (a slow primary can't eat the whole clock). Without a fallback the primary gets it all.
LLM_PRIMARY_TIMEOUT=7
# Same cap for a screenshot-only request, which has no instant rules result to show while it waits and
# takes longer to read. Keep it under the page's own 20s abort.
LLM_TOTAL_TIMEOUT_VISION=18
# Reply budget. Thinking models spend part of it on hidden reasoning, so don't set it too low.
LLM_MAX_TOKENS=2048
CORS_ORIGINS=*

# Satark uses any OpenAI-compatible chat endpoint. Default: Gemini (free key from aistudio.google.com).
# Leave LLM_API_KEY empty to run rules-only.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# true lets the model read screenshots directly (needed in deployment, where there is no Tesseract)
LLM_VISION=true

# Optional: tried once (same endpoint and key) if LLM_MODEL still fails after its retries.
# Pick a model from a different capacity pool, e.g. a "flash-lite" variant of the primary.
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

LLM_TIMEOUT=40
# Reply budget. Thinking models spend part of it on hidden reasoning, so don't set it too low.
LLM_MAX_TOKENS=2048
CORS_ORIGINS=*
